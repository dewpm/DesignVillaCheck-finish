# Node.js 24+, copy to .env. Never commit credentials.
BACKEND_PORT=3001
BACKEND_HOST=127.0.0.1
APP_URL=http://localhost:8443
DATABASE_PATH=./server/data/villacheck.sqlite
# PostgreSQL online: when set, DATABASE_URL takes priority over DATABASE_PATH.
# Use your provider's TLS-enabled pooled URL. Keep this secret on the Backend.
DATABASE_URL=
# Direct PostgreSQL URL for Prisma migrations; never use a transaction pooler here.
DIRECT_URL=
# Retry only advisory-lock contention (12 attempts, about 3 minutes).
MIGRATION_LOCK_MAX_ATTEMPTS=12
SEED_DEMO_ACCOUNTS=false

# Initial admin creation; password is hashed and never overwritten on restart.
ADMIN_EMAIL=villacheck69@gmail.com
ADMIN_PASSWORD=

# Set your actual bank/account instructions before merchants can submit slips.
PAYMENT_INSTRUCTIONS=

# SMTP: port 587 uses mandatory STARTTLS; port 465 uses SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=villacheck69@gmail.com
SMTP_PASSWORD=
SMTP_FROM=villacheck69@gmail.com

# NODE_ENV=production requires APP_URL=https://... and disables demo accounts.
# SERVE_FRONTEND=true serves the built dist/ app from the backend.
SERVE_FRONTEND=false

# OAuth client secrets stay on the backend. Callback URLs must exactly match APP_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Set to the Graph API version selected in your Meta app (e.g. vXX.0).
FACEBOOK_GRAPH_VERSION=

# Optional live map embed. Google Maps links work without this public embed key.
# Restrict the key by HTTP referrer and enable only Maps Embed API.
VITE_GOOGLE_MAPS_EMBED_KEY=

NEXT_PUBLIC_SUPPORT_EMAIL=villacheck69@gmail.com

# AUTO currently falls back to manual review until a provider is integrated.
PAYMENT_VERIFICATION_MODE=MANUAL

# Next.js public contact settings; never put secrets in NEXT_PUBLIC_.
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Required only when explicitly seeding dummy data into an online test database.
DEMO_PASSWORD=

# LINE Login channel (server-only); enable email permission in LINE Developers
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Login OTP: server-only random secret (32+ characters), SMTP for email.
OTP_SECRET=
# SMS OTP via ThaiBulkSMS SMS API v2 (not the separate OTP Service).
THAIBULKSMS_API_KEY=
THAIBULKSMS_API_SECRET=
THAIBULKSMS_SENDER=
